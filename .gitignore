# ── Compilation ──────────────────────────────────────────────────────────────
/target/
**/*.rs.bk

# ── Données d'une installation : JAMAIS en ligne ─────────────────────────────
# Classeurs, base de référence, réglages, journaux et images téléchargées
# vivent dans Application\, à côté des exécutables. Les images sont des scans
# Konami : elles ne se redistribuent pas.
/Application/
/bdd/
/img/
/logs/
/export/
/backups/
*.db-shm
*.db-wal
crash_natif.log
first_run.flag

# ── Dossiers de travail du poste de développement ───────────────────────────
/Distribution/
/Publication/
/Sauvegardes/
/Simulation_alias/
/_a_supprimer/

# ── Archives posées à la racine (livraisons, sauvegardes) ───────────────────
/*.zip
/*.rar
/*.7z
/*.tar.gz
